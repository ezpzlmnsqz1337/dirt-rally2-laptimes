# Google Maps API key (required for the map to work)
# Get one at https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=
# Google Maps Map ID (required for AdvancedMarker)
# Create at https://console.cloud.google.com/google/maps-apis/maps
VITE_GOOGLE_MAPS_MAP_ID=
# PostgREST base URL (optional). Defaults to http://localhost:3003 on loopback hosts
# and http://192.168.0.102:3003 elsewhere.
VITE_API_URL=
